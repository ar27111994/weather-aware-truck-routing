# Haulcast environment variables. Copy to .env.local (gitignored) and fill in; never commit values.
# Local: .env.local. Vercel: environment variables (Production and Preview each have their own
# DJANGO_SECRET_KEY, RATE_LIMIT_SALT and CRON_SECRET). CI: GitHub Actions repository secrets, plus
# the three database secrets of the `production` environment. Details: docs/CI-CD.md.

# --- Django ---------------------------------------------------------------------------------
# Enables Django debug mode. Defaults to false when unset; never enable in production.
DEBUG=
# Long random string. Django refuses to use an empty key. Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
# Comma-separated hostnames the API answers to, e.g. localhost,127.0.0.1. Empty rejects every host.
# On Vercel the deployment's own hosts (VERCEL_URL, VERCEL_BRANCH_URL, VERCEL_PROJECT_PRODUCTION_URL)
# are always allowed as well, because a preview host changes with every deployment and cannot be
# listed here; list the stable production domains and any custom domain.
ALLOWED_HOSTS=
# Optional git SHA (7-40 hex chars) reported by GET /api/v1/health. Falls back to VERCEL_GIT_COMMIT_SHA.
COMMIT_SHA=
# Extra origins (comma-separated, https://host[:port]) that may send POST requests; the API's own
# host is always allowed. Empty means same-origin only. The API has no cookies, so this is defence
# in depth.
ALLOWED_ORIGINS=
# Set to production to make startup fail fast on missing production settings outside Vercel. On
# Vercel the platform's VERCEL_ENV (production or preview) has the same effect.
HAULCAST_ENV=
# Header that carries the trustworthy client IP for rate limiting. Defaults to x-forwarded-for on
# Vercel (the platform overwrites it) and to the socket address elsewhere; a spoofed forwarded
# chain is never parsed.
CLIENT_IP_HEADER=

# --- Supabase Postgres ----------------------------------------------------------------------
# Project reference (20 lowercase letters) of the Supabase project.
SUPABASE_PROJECT_REF=
# Owner (postgres role) password. Used only to build the DSNs below and for migrations; the
# runtime connects as the least-privilege haulcast_app role.
SUPABASE_OWNER_DB_PASSWORD=
# Administrator DSN through the Supavisor SESSION pooler (port 5432, sslmode=require), as the
# Supabase postgres.<ref> user. Its CREDENTIALS are used only by backend/scripts/bootstrap_db.py
# (one run per database); its host, port and database also tell migrations where to connect (as
# haulcast_owner). Shape: postgresql://postgres.<ref>:<password>@<pooler-host>:5432/postgres?sslmode=require
DATABASE_URL=
# Coordinates (host, port, database) of the Supavisor TRANSACTION pooler (port 6543,
# sslmode=require). The serverless runtime connects here as haulcast_app; credentials in this URL
# are ignored (the settings apply prepare_threshold=None, which psycopg needs behind it).
DATABASE_URL_POOLED=
# Password (at least 16 characters) of the least-privilege runtime role haulcast_app (DML only).
# backend/scripts/bootstrap_db.py creates the role with it and the runtime connects with it.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
HAULCAST_APP_DB_PASSWORD=
# Password (at least 16 characters) of the schema-owner role haulcast_owner (DDL; owns schema app).
# bootstrap_db.py creates the role with it and migrations connect with it; the runtime never needs
# it. Same generator as above.
HAULCAST_OWNER_DB_PASSWORD=

# --- Application secrets --------------------------------------------------------------------
# Salt for HMAC-SHA256 hashing of client IPs in the rate limiter (raw IPs are never stored).
RATE_LIMIT_SALT=
# Bearer secret for GET|POST /api/v1/internal/maintenance (Vercel Cron issues GET). Unset makes the
# endpoint answer 404.
CRON_SECRET=
# Truck top speed in km/h handed to the Valhalla truck costing (40 to 120; default 105).
TRUCK_TOP_SPEED_KPH=
# Directory with risk-rules.json and scenarios/ (defaults to the repository's shared/ directory).
HAULCAST_SHARED_DIR=

# --- Tests ----------------------------------------------------------------------------------
# Database the backend test-suite runs against. The suite ignores DATABASE_URL on purpose.
# Local: `export "$(bash scripts/dev-db.sh url)"` (EDB Postgres 17 on 127.0.0.1:54329).
TEST_DATABASE_URL=
# Name of the database the suite creates inside that server. Set one per concurrent suite when
# several share a server (default: Django's test_ prefix plus the database name).
HAULCAST_TEST_DB_NAME=
# Hypothesis profile: dev (default, fast) or ci (more examples).
HYPOTHESIS_PROFILE=
