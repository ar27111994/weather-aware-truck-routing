{
  "openapi": "3.1.0",
  "info": {
    "title": "Haulcast API",
    "version": "0.1.0",
    "description": "Weather-aware truck routing: route options, weather checkpoints and risk."
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Liveness probe (never touches the database)",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        },
        "description": "Report liveness, the semantic version and the short git SHA of this build.",
        "tags": [
          "health"
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "HealthResponse": {
        "description": "Body of ``GET /api/v1/health``.",
        "properties": {
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          },
          "commit": {
            "title": "Commit",
            "type": "string"
          }
        },
        "required": [
          "status",
          "version",
          "commit"
        ],
        "title": "HealthResponse",
        "type": "object"
      }
    }
  },
  "servers": []
}