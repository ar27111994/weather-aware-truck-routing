{
  "name": "haulcast-frontend",
  "private": true,
  "version": "0.1.0",
  "description": "Haulcast web app: React 19 + React Router 7 (framework mode, prerendered SPA).",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "preview": "sirv build/client --single __spa-fallback.html --host 127.0.0.1 --port 4173",
    "typecheck": "react-router typegen && tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@react-router/node": "7.18.4",
    "isbot": "5.2.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@react-router/dev": "7.18.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "sirv-cli": "3.0.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "7.3.7",
    "vitest": "5.0.5"
  }
}
