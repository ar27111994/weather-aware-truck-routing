{
  "name": "haulcast-frontend",
  "private": true,
  "version": "0.1.0",
  "description": "Haulcast web app: React 19 + React Router 7 (framework mode, prerendered SPA).",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "preview": "node scripts/preview.ts",
    "tokens": "node scripts/build-tokens.ts",
    "tokens:check": "node scripts/build-tokens.ts --check",
    "brand": "node scripts/render-brand.ts",
    "styles:types": "cmk",
    "typecheck": "cmk && react-router typegen && tsc --noEmit",
    "lint": "cmk && eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/overpass": "5.3.0",
    "@fontsource-variable/overpass-mono": "5.3.0",
    "@internationalized/date": "3.12.4",
    "@react-router/node": "7.18.4",
    "@tanstack/react-query": "5.104.4",
    "isbot": "5.2.2",
    "lucide-react": "1.59.0",
    "react": "19.3.1",
    "react-aria": "3.53.1",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.1",
    "react-router": "7.18.4",
    "react-stately": "3.51.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@css-modules-kit/codegen": "1.4.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@react-router/dev": "7.18.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "4.10.2",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "msw": "3.0.3",
    "prettier": "3.9.10",
    "sirv": "3.0.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "7.3.7",
    "vitest": "5.0.5",
    "vitest-axe": "0.1.0"
  }
}
