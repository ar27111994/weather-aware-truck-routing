{
  "components": {
    "schemas": {
      "FieldErrorSchema": {
        "description": "One invalid field of a validation problem.",
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Loc",
            "type": "array"
          },
          "msg": {
            "title": "Msg",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "FieldErrorSchema",
        "type": "object"
      },
      "GeocodeResponse": {
        "description": "Body of ``GET /api/v1/geocode``: the normalised query and its candidates, best first.",
        "properties": {
          "query": {
            "title": "Query",
            "type": "string"
          },
          "results": {
            "items": {
              "$ref": "#/components/schemas/GeocodeResult"
            },
            "title": "Results",
            "type": "array"
          }
        },
        "required": [
          "query",
          "results"
        ],
        "title": "GeocodeResponse",
        "type": "object"
      },
      "GeocodeResult": {
        "description": "One candidate place. Every text field is plain data for the UI to render as text.",
        "properties": {
          "country": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Country"
          },
          "country_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Country Code"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "title": "Kind",
            "type": "string"
          },
          "label": {
            "title": "Label",
            "type": "string"
          },
          "lat": {
            "title": "Lat",
            "type": "number"
          },
          "lon": {
            "title": "Lon",
            "type": "number"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "region": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Region"
          }
        },
        "required": [
          "id",
          "label",
          "name",
          "region",
          "country",
          "country_code",
          "kind",
          "lat",
          "lon"
        ],
        "title": "GeocodeResult",
        "type": "object"
      },
      "HealthResponse": {
        "description": "Body of ``GET /api/v1/health``.",
        "properties": {
          "commit": {
            "title": "Commit",
            "type": "string"
          },
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "version",
          "commit"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "MaintenanceResponse": {
        "description": "Outcome of one maintenance run.",
        "properties": {
          "deleted": {
            "additionalProperties": {
              "type": "integer"
            },
            "title": "Deleted",
            "type": "object"
          },
          "ran_at": {
            "format": "date-time",
            "title": "Ran At",
            "type": "string"
          }
        },
        "required": [
          "ran_at",
          "deleted"
        ],
        "title": "MaintenanceResponse",
        "type": "object"
      },
      "ProblemSchema": {
        "description": "``application/problem+json`` body of every error response (RFC 9457 plus our extensions).",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "errors": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/FieldErrorSchema"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Errors"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code",
          "request_id"
        ],
        "title": "ProblemSchema",
        "type": "object"
      },
      "ReadyResponse": {
        "description": "Body of ``GET /api/v1/health/ready``.",
        "properties": {
          "commit": {
            "title": "Commit",
            "type": "string"
          },
          "database": {
            "const": "ok",
            "title": "Database",
            "type": "string"
          },
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "database",
          "version",
          "commit"
        ],
        "title": "ReadyResponse",
        "type": "object"
      },
      "ScenarioSummarySchema": {
        "description": "What a scenario picker needs: the id to send back and the words to show.",
        "properties": {
          "description": {
            "title": "Description",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "description"
        ],
        "title": "ScenarioSummarySchema",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Weather-aware truck routing: route options, weather checkpoints and risk.",
    "title": "Haulcast API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/geocode": {
      "get": {
        "description": "Return up to ``limit`` places matching ``q`` (2 to 120 characters once normalised).",
        "operationId": "geocode",
        "parameters": [
          {
            "in": "query",
            "name": "q",
            "required": true,
            "schema": {
              "maxLength": 512,
              "title": "Q",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 5,
              "maximum": 8,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GeocodeResponse"
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemSchema"
                }
              }
            },
            "description": "Bad Request"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemSchema"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemSchema"
                }
              }
            },
            "description": "Too Many Requests"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemSchema"
                }
              }
            },
            "description": "Internal Server Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemSchema"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Search places by free text (US-biased)",
        "tags": [
          "geocoding"
        ]
      }
    },
