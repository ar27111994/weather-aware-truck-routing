# --- Secrets and local environment (never commit; .env.example is the only tracked variant) ---
.env
.env.*
!.env.example

# --- Local-only tooling state ---
.local/
.planning/
.vercel/

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
.coverage.*
coverage.xml
htmlcov/

# --- Node / frontend ---
node_modules/
.pnpm-store/
*.tsbuildinfo
npm-debug.log*
pnpm-debug.log*
yarn-error.log*

# --- Vite / React Router build output ---
build/
dist/
.react-router/
# Typed CSS-module declarations generated by `cmk` (pnpm styles:types, typecheck, lint).
.css-modules/

# --- Test and coverage output ---
coverage/
playwright-report/
test-results/
blob-report/
playwright/.cache/
.lighthouseci/

# --- Vercel: the Python builder derives these from api/requirements.txt on every build ---
api/pyproject.toml
api/uv.lock

# --- OS / editor ---
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
