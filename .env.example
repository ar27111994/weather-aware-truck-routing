# Haulcast environment variables. Copy to .env.local (gitignored) and fill in; never commit values.
# Local: .env.local. Production: Vercel environment variables. CI: GitHub Actions secrets.

# --- Django ---------------------------------------------------------------------------------
# Enables Django debug mode. Defaults to false when unset; never enable in production.
DEBUG=
# Long random string. Django refuses to use an empty key. Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
# Comma-separated hostnames the API answers to, e.g. localhost,127.0.0.1. Empty rejects every host.
ALLOWED_HOSTS=
# Optional git SHA (7-40 hex chars) reported by GET /api/v1/health. Falls back to VERCEL_GIT_COMMIT_SHA.
COMMIT_SHA=

# --- Supabase Postgres ----------------------------------------------------------------------
# Project reference (20 lowercase letters) of the Supabase project.
SUPABASE_PROJECT_REF=
# Owner (postgres role) password. Used only to build the DSNs below and for migrations; the
# runtime connects as the least-privilege haulcast_app role.
SUPABASE_DB_PASSWORD=
# Owner DSN through the Supavisor SESSION pooler (port 5432, sslmode=require). Django's default
# database; migrations run against it. Shape: postgresql://postgres.<ref>:<password>@<pooler-host>:5432/postgres?sslmode=require
DATABASE_URL=
# Owner DSN through the Supavisor TRANSACTION pooler (port 6543, sslmode=require). Reserved for the
# serverless runtime; psycopg needs prepare_threshold=None behind it.
DATABASE_URL_POOLED=
# Password for the least-privilege runtime role haulcast_app (created by backend migrations).
HAULCAST_APP_DB_PASSWORD=

# --- Application secrets --------------------------------------------------------------------
# Salt for HMAC-SHA256 hashing of client IPs in the rate limiter (raw IPs are never stored).
RATE_LIMIT_SALT=
# Bearer secret for POST /api/v1/internal/maintenance (Vercel Cron). Unset makes the endpoint 404.
CRON_SECRET=

# --- Tests ----------------------------------------------------------------------------------
# Database the backend test-suite runs against. The suite ignores DATABASE_URL on purpose.
# Local: `export "$(bash scripts/dev-db.sh url)"` (EDB Postgres 17 on 127.0.0.1:54329).
TEST_DATABASE_URL=
# Hypothesis profile: dev (default, fast) or ci (more examples).
HYPOTHESIS_PROFILE=
